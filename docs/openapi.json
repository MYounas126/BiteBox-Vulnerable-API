          "200": {
            "description": "OK"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "name": "Test Customer",
                "email": "trainee1@lab.test",
                "password": "Passw0rd!lab",
                "phone": "+920000001001",
                "accountType": "customer"
              }
            }
          }
        }
      }
    },
